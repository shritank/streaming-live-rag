*.pyc
.pytest_cache/
*.egg-info/

.env
*.env.local

# large / regenerable data (fixtures/dev_corpus and data/corpus ARE committed —
# they are the reproducible output of build_dev_corpus.py / build_squad_corpus.py)
data/raw/
generated/
