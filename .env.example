# Copy to .env and fill in. Never commit the real .env (it is git-ignored).

# fake | openai | gemini — "fake" needs no key and runs fully offline.
LLM_PROVIDER=fake
LLM_MODEL=fake-model
SECRET_LLM_API_KEY=

# Neural retrieval cache location and ONNX Runtime thread count (optional).
STREAMING_RAG_CACHE=.cache/streaming_rag
# empty = automatic (all CPU cores on the CPU path, 4 on CUDA)
STREAMING_RAG_ORT_THREADS=
# auto (default): CUDA is MANDATORY whenever an NVIDIA GPU is present (raises instead of using the CPU)
# | cuda | cpu (explicit opt-out). Needs onnxruntime-gpu + CUDA 12 / cuDNN 9.
STREAMING_RAG_ORT_PROVIDER=auto
# auto/1: fused-graph RAG models on CUDA (python -m streaming_rag.retrieval.neural --fuse) | 0
STREAMING_RAG_ORT_FUSED=auto
# Whisper audio front end: auto (mandatory GPU when present) | cuda | cpu
STREAMING_RAG_ASR_DEVICE=auto
